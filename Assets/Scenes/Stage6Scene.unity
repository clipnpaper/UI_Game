  speechBubble: {fileID: 1650420834}
  speechText: {fileID: 989407626}
  messages:
  - "\uC548\uB155! \uB098\uB294 \uB108\uC5D0\uAC8C \uB3C4\uC6C0\uC744 \uC904 \uC548\uB0B4\uACAC\uC774\uC57C.
    \uC798 \uBD80\uD0C1\uD574!"
  - "\uBB34\uC2A8 \uB3C4\uC6C0\uC774 \uD544\uC694\uD574??"
  - "\uC544, \uB85C\uADF8\uC778 \uBC84\uD2BC\uC774 \uC5C6\uB2E4\uACE0?"
  - "\uC54C\uACA0\uC5B4. \uB0B4\uAC00 \uD55C\uBC88 \uCC3E\uC544\uBCFC\uAC8C."
  - "\uCC3E\uB294 \uB3D9\uC548 \uC2DC\uAC04\uC774 \uAC78\uB9AC\uB294\uB370 \uB098\uB791
    \uC218\uB2E4\uB098 \uD560\uB798?"
  - "\uC544, \uBE68\uB9AC \uB85C\uADF8\uC778\uD574\uC57C \uD55C\uB2E4\uACE0? \uADF8\uB798
    \uC54C\uACA0\uC5B4."
  - "\uADFC\uB370 \uADF8\uAC70 \uC54C\uC544? \uB808\uBAAC \uD55C \uAC1C\uC5D0\uB294
    \uBB34\uB824 \uB808\uBAAC 4\uAC1C \uBD84\uB7C9\uC758 \uBE44\uD0C0\uBBFC\uC774
    \uB4E4\uC5B4\uC788\uB2E4\uB294 \uC0AC\uC2E4!"
  - "\uC54C\uACE0 \uC788\uC5C8\uB2E4\uBA74 \uC720\uAC10!"
  - "\uC544, \uBE68\uB9AC \uB85C\uADF8\uC778 \uBC84\uD2BC \uB2EC\uB77C\uACE0?  \uC54C\uC558\uB2E4\uB2C8\uAE4C?"
  - "\uC790, \uC5EC\uAE30\uC788\uC5B4."
  - 
  - 
  - 
  - 
  - 
  typingSpeed: 0.05
